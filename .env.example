# Copy to .env and adjust as needed: `cp .env.example .env`

RAILS_ENV=development

# Compose-level; feed DATABASE_URL (see docker-compose.yml).
DB_DATABASE=budget_biller_development
DB_USERNAME=app
DB_PASSWORD=secret

# Host-side port for psql/GUI access.
FORWARD_DB_PORT=5432

# The spec suite's database. Defaults to DATABASE_URL + "_test" (see
# config/database.yml) so specs never truncate the development data.
# TEST_DATABASE_URL=postgres://app:secret@postgres:5432/budget_biller_test

# Connection pool size — must exceed the concurrency spec's thread count
# (04-testing.md §4).
RAILS_MAX_THREADS=10

# Seconds a worker sleeps when it finds no work.
BILLING_POLL_INTERVAL=5

# Lease seconds; must exceed worst-case batch duration (task-instructions.md §6.4).
BILLING_LEASE_TTL=60

# Poison-batch bound.
BILLING_MAX_ATTEMPTS=5

COMPOSE_PROJECT_NAME=budget_biller

# Host user mapped into the container (bind-mounted files stay editable on the host).
UID=1000
GID=1000
